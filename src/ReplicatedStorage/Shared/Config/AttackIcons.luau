--[[
	AttackIcons — illustration de chaque attaque (dessinée par Modules/AttackIcon).
	Une fiche = liste de couches dessinées dans l'ordre (coordonnées 0..1, y vers le bas) :
		{ "e", emoji, x, y, taille, rotation, a = transparence, k = contour }   emoji (Twemoji Roblox, Unicode <= 12)
		{ "t", texte, x, y, hauteur, rotation, c = couleur, w = largeur }       texte pixel
		{ "d", accessoire, x, y, taille, rotation, extra... }                   accessoire dessiné (voir PROPS dans AttackIcon)
		{ "speed", x, y, taille, direction, couleur }   traits de vitesse (direction du mouvement, 0 = vers la droite)
		{ "burst", x, y, taille, couleur }              étoile d'impact
		{ "shock", x, y, taille }                       onde de choc au sol
		{ "rings", x, y, taille, n, couleur }           anneaux concentriques
		{ "arrow", x, y, taille, direction, couleur }   flèche (90 = vers le bas)
		{ "arc", x, y, rayon, angle0, angle1, épaisseur, couleur, pointe }
		{ "cone", x, y, longueur, direction, ouverture, couleur, n }
		{ "zig", x0, y0, x1, y1, couleur }              éclair
		{ "spark", x, y, taille }  { "conv", y }  { "bits", x, y, taille, n }  { "shadow", x, y, largeur }  { "shake", x, y, taille }
	Champs : b = badge ("pin" "counter" "burn" "slow" "blind" "mark" "stun" "trip" "buff" "heal" "freeze" "drain" "grab", false = aucun ;
	         absent = déduit des Effects de l'attaque), tier = "Base"/"Trans"/"Ult"/"Slot" (sinon déduit du perso), bg = couleur de fond.
	Clés : Attacks[id d'attaque], Ults[id du perso], Slots[action].
]]
